# Backend Environment Variables
# Copy this file to .env and fill in values

# Application
APP_NAME=AgriPredict AI
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./agripredict.db

# CORS - Frontend URL
FRONTEND_URL=http://localhost:5173

# Open-Meteo API (no key required for free tier)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Demo Mode - set to true to use sample data without API calls
DEMO_MODE=false

# Logging
LOG_LEVEL=INFO
